{
  "name": "@zonease/aiworker-storage-sqlite",
  "type": "module",
  "private": true,
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./worker": {
      "types": "./src/worker/index.ts",
      "import": "./src/worker/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout=15000",
    "test:stress": "bun test --timeout=15000 --rerun-each=3 src/worker/index.test.ts",
    "db:generate:worker": "drizzle-kit generate --config drizzle.worker.config.ts",
    "db:generate": "bun run db:generate:worker"
  },
  "dependencies": {
    "@zonease/aiworker-soul-descriptor": "workspace:*",
    "drizzle-orm": "^0.44.1"
  },
  "devDependencies": {
    "@types/bun": "^1.2.13",
    "drizzle-kit": "^0.31.1",
    "typescript": "^5.8.3"
  }
}
