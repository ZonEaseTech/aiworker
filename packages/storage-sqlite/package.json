{
  "name": "@aiworker/storage-sqlite",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./fleet": {
      "types": "./src/fleet/index.ts",
      "import": "./src/fleet/index.ts"
    },
    "./worker": {
      "types": "./src/worker/index.ts",
      "import": "./src/worker/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate:fleet": "drizzle-kit generate --config drizzle.fleet.config.ts",
    "db:generate:worker": "drizzle-kit generate --config drizzle.worker.config.ts",
    "db:generate": "bun run db:generate:fleet && bun run db:generate:worker"
  },
  "dependencies": {
    "@aiworker/shared": "workspace:*",
    "drizzle-orm": "^0.44.1"
  },
  "devDependencies": {
    "@types/bun": "^1.2.13",
    "drizzle-kit": "^0.31.1",
    "typescript": "^5.8.3"
  }
}
