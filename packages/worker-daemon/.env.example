# Worker daemon package env subset.
# In a source checkout, ../../.env.example is the repo-level source of truth.
# Package artifacts may not include that root file, so keep this file as a
# package-local subset for Docker/package consumers that run worker-daemon directly.
AIWORKER_MODE=worker

# Required/recommended when binding worker-daemon beyond loopback; must be at
# least 16 chars if set.
AIWORKER_LOCAL_TOKEN=

# 32 bytes hex. Generate with: openssl rand -hex 32
AIWORKER_MASTER_KEY=

# Generate with: openssl rand -hex 24
INTERNAL_SHARED_SECRET=

CLOUD_GATEWAY_MCP_URL=
CLOUD_GATEWAY_MCP_TOKEN=
CLOUD_GATEWAY_DEFAULT_CATEGORY=
CLOUD_GATEWAY_DEFAULT_TYPE_ID=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=60000
PORT=9217
MAX_CONCURRENT_TOTAL=4
PROCESS_STALL_TIMEOUT_MS=120000
PROCESS_KILL_TIMEOUT_MS=10000
PROCESS_AUTO_CLEANUP_DELAY_MS=60000
PROCESS_GC_INTERVAL_MS=30000
