# Host-local env for the production docker compose stack.
#
# Copy to /opt/aiworker-deploy/.env on the deploy target and fill in every
# REQUIRED value before running `scripts/deploy.ts install`. The deploy script
# refuses to proceed if AIWORKER_MASTER_KEY, INTERNAL_SHARED_SECRET, or
# AIWORKER_IMAGE_TAG are missing.

# REQUIRED. 32-byte hex (64 chars). Encrypts registered_workers.apiTokenEnc.
# Generate once: `openssl rand -hex 32`. BACK THIS UP — losing it bricks every
# registered worker's stored bearer token.
AIWORKER_MASTER_KEY=

# REQUIRED. Shared secret for internal calls (management auth). >= 16 chars.
# Generate: `openssl rand -hex 24`.
INTERNAL_SHARED_SECRET=

# OPTIONAL. Default image tag used when running `docker compose up -d`
# directly on the host (images live at ghcr.io/zoneasetech/aiworker:<tag>).
# The deploy script overrides this via inline env on
# `scripts/deploy.ts install --tag=<tag>`, so .env only needs to hold the
# last known-good tag for rollback purposes. Swap to a previous tag and
# rerun `install` (or `docker compose up -d` on the host) to roll back.
AIWORKER_IMAGE_TAG=

# OPTIONAL. Image variant suffix (FEAT-020). Empty = slim (~150 MB, no
# agentic CLIs baked in — workers fall back to `npx -y` at first use).
# `-full` = full (~300 MB, claude-code / codex / gemini-cli / qwen-code
# pre-installed at pinned versions; Cursor is opt-in via FEAT-021).
# The deploy script sets this via `--image-variant=slim|full`; .env holds
# the default for manual `docker compose up -d`.
AIWORKER_IMAGE_VARIANT_SUFFIX=

# -----------------------------------------------------------------------------
# PLAN-010 — manager-driven worker creation. All of the following are OPTIONAL
# and only read when you combine the base compose with
# `docker-compose.supervisor.yml`. See docs/deployment.md#enabling-manager-
# driven-worker-creation for the full runbook.
# -----------------------------------------------------------------------------

# PLAN-010 §P3. Hard cap on rows in registered_workers, applied to both
# /api/workers/register and /api/workers/launch-local. Leave empty for no cap.
MANAGER_MAX_WORKERS=

# PLAN-010 §P5. Memory ceiling for each launched worker container (docker
# --memory syntax, e.g. `256m`, `1g`). Default 512m.
WORKER_MEMORY_LIMIT=

# PLAN-010 §P5. CPU ceiling for each launched worker container (fractional
# cores, e.g. `0.5`, `1.0`, `2.0`). Default 1.0.
WORKER_CPU_LIMIT=

# PLAN-010 §P5. Override the URL template used to reach launched workers.
# Only needed if the default (`http://{containerName}:3001`) doesn't fit
# your single-host network topology. `{containerName}` and `{port}` are
# substituted.
AIWORKER_LAUNCH_BASE_URL_TEMPLATE=
