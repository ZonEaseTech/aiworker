{
  "protocol": "soul/v1",
  "identity": {
    "appId": "aiworker-freeform",
    "description": "Open-ended Soul for freeform local work.",
    "name": "AIWorker Freeform",
    "soulId": "freeform",
    "version": "0.1.0"
  },
  "compatibility": {
    "engines": [
      "codex",
      "claude-code"
    ],
    "host": ">=1.0.0",
    "sdk": ">=1.0.0"
  },
  "configuration": {
    "defaults": {
      "engine": "codex"
    },
    "features": {
      "engine": true,
      "mcp": true,
      "skills": true,
      "workbench": true,
      "workspaceAssets": true
    },
    "scope": "worker",
    "version": "1"
  },
  "workbench": {
    "entry": "dist/web/workbench/index.html",
    "mode": "sdk-common",
    "router": {
      "mode": "search"
    },
    "type": "micro-app"
  },
  "engine": {
    "workspaceAssets": {
      "source": "dist/engine-assets/workspace"
    },
    "skills": {
      "source": "dist/engine-assets/skills"
    },
    "mcp": {
      "targets": {
        "claude-code": {
          "file": "dist/engine-assets/mcp/claude-code/.mcp.json"
        },
        "codex": {
          "file": "dist/engine-assets/mcp/codex/config.toml"
        }
      }
    }
  },
  "health": {
    "ready": true,
    "type": "static"
  },
  "extensions": {},
  "external": {}
}
