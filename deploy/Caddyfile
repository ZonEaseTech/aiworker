# AIWorker — Managed-Access RC single-origin reverse proxy
#
# Host = dedicated box 172.105.219.50; DNS aiworker.zonease.org -> this box (D2).
# Host process listens on loopback 127.0.0.1:9117 (aiworker-host daemon foreground).
#
# Host is ALREADY single-origin: one process dispatches by path —
#   /host, /host/*, /                      (Host Web, login-gated)
#   /auth/login, /auth/callback, /auth/logout, /api/auth/me   (Logto session)
#   /api/host/options, /api/host/assignments
#   /api/provision/check-in
#   /api/provision/access                  (WebSocket upgrade — server.upgrade)
#   /workers/:id                           (reverse tunnel forward)
# => Caddy only needs to forward EVERYTHING to the single upstream.
#
# Caddy v2 proxies WebSocket upgrades transparently (no special directive).
# C1 (idle): no special idle config needed — the worker-side app-layer keepalive
# ping (default 25s, US-003) keeps /api/provision/access flowing, so the stream
# never goes idle long enough for any default timeout to reap it.

aiworker.zonease.org {
	encode zstd gzip

	# Single Host upstream — all routes (incl. the provision WS) go here.
	reverse_proxy 127.0.0.1:9117 {
		# Disable response buffering so streaming / long-lived WS frames flush
		# immediately and the tunnel is never held mid-stream.
		flush_interval -1
	}

	# Automatic TLS via ACME. Requires :80 + :443 reachable AND DNS resolving here.
	# Access log (JSON) records 101 Upgrade + status codes — the cornerstone
	# observation reads this alongside the Host per-request forward log (US-001)
	# to triangulate /workers/:A vs /workers/:B routing (AC3 + AC7).
	log {
		output file /var/log/caddy/aiworker-access.log
		format json
	}
}
