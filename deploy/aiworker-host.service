# AIWorker Host — Managed-Access RC systemd unit (D1: long-lived, not "demo-time manual start")
#
# Install:
#   sudo cp deploy/aiworker-host.service /etc/systemd/system/aiworker-host.service
#   sudo install -d -m 700 -o aiworker -g aiworker /etc/aiworker
#   sudo install -m 600 -o aiworker -g aiworker deploy/host.env.example /etc/aiworker/host.env  # then fill the 6 keys
#   sudo systemctl daemon-reload && sudo systemctl enable --now aiworker-host
#
# Verify on the box:  systemd-analyze verify /etc/systemd/system/aiworker-host.service

[Unit]
Description=AIWorker Host (Managed-Access RC)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aiworker
Group=aiworker

# C2: the six all-or-nothing Logto/session runtime keys are injected HERE from a
# 600 file that is NEVER committed. Host reads them from process.env, fail-closed —
# a partial set makes startup fail by design (AGENTS.md Host session auth contract).
EnvironmentFile=/etc/aiworker/host.env

# Caddy terminates TLS and reverse-proxies to this loopback port (matches Caddyfile).
Environment=AIWORKER_HOST_API_PORT=9117

# Replace with the real installed entrypoint on the box. Either the packaged bin:
ExecStart=/usr/local/bin/aiworker-host daemon foreground --port 9117
# ...or a bun-run checkout: ExecStart=/usr/bin/bun /opt/aiworker/apps/host-cli/src/aiworker-host.ts daemon foreground --port 9117

Restart=on-failure
RestartSec=3

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=aiworker
LogsDirectory=aiworker caddy
ReadWritePaths=/var/lib/aiworker /var/log/caddy

[Install]
WantedBy=multi-user.target
