# AIWorker Host runtime auth — Managed-Access RC TEMPLATE (no secrets here).
#
# Deploy as /etc/aiworker/host.env, chmod 600, owned by the service user, and
# inject via systemd EnvironmentFile= (see aiworker-host.service). C2/Q3 decision:
# server-protected 600 .env, NEVER committed / never in descriptor / DB / log.
#
# NOTE: this file is intentionally named host.env.example (NOT .env.example) and
# lives under deploy/ so it is OUTSIDE the dev:env:check env-contract, which only
# syncs root .env<->.env.example and packages/worker-daemon/.env<->.env.example
# (scripts/check-env-structure.ts:29-30, hardcoded pair list — no glob).

# --- Public origin (D2): non-loopback, reachable from worker vm-nodes ---
AIWORKER_HOST_BROWSER_BASE_URL=https://aiworker.zonease.org
AIWORKER_HOST_CONTROL_BASE_URL=https://aiworker.zonease.org

# --- The six all-or-nothing Logto / session runtime keys (fill on the box) ---
# C2: who holds the real tenant credentials -> you inject the secret values.
AIWORKER_HOST_SESSION_SECRET=
# D4 (non-secret decision, pre-filled): cornerstone employees must be in these domains.
AIWORKER_HOST_ALLOWED_EMAIL_DOMAINS=zonease.org,ttpos.org,jbcnet.co.jp
LOGTO_CLIENT_ID=
LOGTO_CLIENT_SECRET=
LOGTO_ENDPOINT=
LOGTO_ISSUER=

# Loopback API port Caddy proxies to (matches Caddyfile upstream + the unit).
AIWORKER_HOST_API_PORT=9117
