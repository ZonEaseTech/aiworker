# AIWorker runtime home (per-worker brain / skills / memories / workspaces).
# Defaults to ~/.aiworker when unset. Override for multi-tenant dev layouts
# or containerised runs (the docker image sets this to /var/lib/aiworker).
# AIWORKER_HOME=~/.aiworker

# Master key for the secrets vault (worker mode). 32 bytes hex.
# Generate: openssl rand -hex 32
AIWORKER_MASTER_KEY=

# Cloud Gateway (Brain via MCP) — optional secondary knowledge source.
# Leave blank to skip. Used only when a worker's config references a
# `cloud-gateway` brain source.
CLOUD_GATEWAY_MCP_URL=
CLOUD_GATEWAY_MCP_TOKEN=
# Default category or type_id for writeMemory when caller does not specify.
CLOUD_GATEWAY_DEFAULT_CATEGORY=
CLOUD_GATEWAY_DEFAULT_TYPE_ID=

# OpenAI-compatible executor (default http engine fallback).
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=60000

# Server
PORT=3001

# ProcessManager (FEAT-015) — slot 上限与 stall / GC 时延
# 全局并发 slot 总量
MAX_CONCURRENT_TOTAL=4
# 单 engine 上限：MAX_CONCURRENT_<ENGINE>，engine 名 dash → underscore + 大写
# 示例：MAX_CONCURRENT_CLAUDE_CODE=2 / MAX_CONCURRENT_ACP=2 / MAX_CONCURRENT_HTTP=4
# 未声明的 engine 默认使用 MAX_CONCURRENT_TOTAL
PROCESS_STALL_TIMEOUT_MS=120000
PROCESS_KILL_TIMEOUT_MS=10000
PROCESS_AUTO_CLEANUP_DELAY_MS=60000
PROCESS_GC_INTERVAL_MS=30000
