{
  "name": "@aiworker/api",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/dev.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts"
  },
  "dependencies": {
    "@aiworker/shared": "workspace:*",
    "@hono/zod-openapi": "^0.19.6",
    "@scalar/hono-api-reference": "^0.5.180",
    "consola": "^3.4.2",
    "drizzle-orm": "^0.44.1",
    "hono": "^4.7.7",
    "yaml": "^2.7.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/bun": "^1.2.13",
    "drizzle-kit": "^0.31.1",
    "typescript": "^5.8.3"
  }
}
