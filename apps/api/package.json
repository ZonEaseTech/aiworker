{
  "name": "@aiworker/api",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./lib": {
      "types": "./src/lib.ts",
      "import": "./src/lib.ts"
    }
  },
  "scripts": {
    "dev": "bun --watch src/dev.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@aiworker/fs-layout": "workspace:*",
    "@aiworker/shared": "workspace:*",
    "@aiworker/storage-sqlite": "workspace:*",
    "@hono/zod-openapi": "^0.19.6",
    "@scalar/hono-api-reference": "^0.5.180",
    "consola": "^3.4.2",
    "drizzle-orm": "^0.44.1",
    "hono": "^4.7.7",
    "yaml": "^2.7.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/bun": "^1.2.13",
    "typescript": "^5.8.3"
  }
}
