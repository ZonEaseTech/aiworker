{
  "name": "@zonease/aiworker-web",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && bun run check:studio-css",
    "check:studio-css": "bun ../../scripts/web-quality.ts studio-css",
    "lint": "eslint src vite.config.ts",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "size:baseline": "bun ../../scripts/web-quality.ts size-report --write-baseline",
    "size:report": "bun ../../scripts/web-quality.ts size-report",
    "test": "vitest run --testTimeout=15000",
    "test:stress": "bun ../../scripts/repeat-command.ts 3 bunx vitest run --testTimeout=15000 src/worker/__tests__/worker-studio.test.tsx"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@zonease/aiworker-component": "workspace:*",
    "@zonease/aiworker-shared": "workspace:*",
    "lucide-react": "^1.8.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@testing-library/dom": "10",
    "@testing-library/react": "16",
    "@types/node": "^25.6.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^6.0.1",
    "happy-dom": "20",
    "typescript": "^5.8.3",
    "vite": "^8",
    "vitest": "4"
  }
}
