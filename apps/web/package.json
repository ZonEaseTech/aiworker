{
  "name": "@zonease/aiworker-web",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && bun run build:fleet && bun run build:worker",
    "build:fleet": "AIWORKER_WEB_BUNDLE=fleet vite build",
    "build:worker": "AIWORKER_WEB_BUNDLE=worker vite build",
    "check:shared-cycles": "bun ../../scripts/web-quality.ts shared-cycles",
    "lint": "eslint src vite.config.ts",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "size:baseline": "bun ../../scripts/web-quality.ts size-report --write-baseline",
    "size:report": "bun ../../scripts/web-quality.ts size-report",
    "test": "vitest run"
  },
  "dependencies": {
    "@base-ui-components/react": "^1.0.0-rc.0",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-query": "^5.99.2",
    "@tanstack/react-query-devtools": "^5.99.2",
    "@tanstack/react-router": "^1.168.23",
    "@zonease/aiworker-gateway-proto": "workspace:*",
    "@zonease/aiworker-shared": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.8.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.4",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tanstack/router-devtools": "^1.166.13",
    "@tanstack/router-plugin": "^1.167.22",
    "@testing-library/dom": "10",
    "@testing-library/react": "16",
    "@types/node": "^25.6.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "happy-dom": "20",
    "typescript": "^5.8.3",
    "vite": "^8",
    "vitest": "4"
  }
}
