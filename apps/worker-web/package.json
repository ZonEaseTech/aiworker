{
  "name": "@zonease/aiworker-worker-web",
  "type": "module",
  "private": true,
  "license": "MIT",
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#hooks/*": "./src/hooks/*.ts",
    "#lib/*": "./src/lib/*.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && bun run check:studio-css",
    "check:studio-css": "bun ../../scripts/web-quality.ts studio-css",
    "check:shared-cycles": "bun ../../scripts/web-quality.ts shared-cycles",
    "lint": "eslint src vite.config.ts",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "size:baseline": "bun ../../scripts/web-quality.ts size-report --write-baseline",
    "size:report": "bun ../../scripts/web-quality.ts size-report",
    "test": "vitest run --testTimeout=15000",
    "test:stress": "bun ../../scripts/repeat-command.ts 3 bunx vitest run --testTimeout=15000 src/worker/__tests__/worker-studio.test.tsx"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.1.4",
    "@hugeicons/react": "^1.1.6",
    "@micro-zoe/micro-app": "^1.0.0-rc.30",
    "@tailwindcss/vite": "^4.2.2",
    "@zonease/aiworker-soul-descriptor": "workspace:*",
    "@zonease/aiworker-ui": "workspace:*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@testing-library/dom": "10",
    "@testing-library/react": "16",
    "@types/node": "^25.6.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^6.0.1",
    "happy-dom": "20",
    "typescript": "^5.8.3",
    "vite": "^8",
    "vitest": "4"
  }
}
