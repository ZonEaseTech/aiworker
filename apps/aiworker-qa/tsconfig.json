{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {
      "@/*": [
        "./host-adapter/*"
      ]
    },
    "types": [
      "@types/bun"
    ]
  },
  "include": [
    "host-adapter/**/*.ts",
    "product/web/**/*.ts",
    "product/web/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
