{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIWorker HR Interview Brief",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "title",
    "summary",
    "evidence"
  ],
  "properties": {
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "source",
          "summary"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "nextActions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
