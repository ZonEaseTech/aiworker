# AIWorker root environment example.
# Copy values into .env for local development. AIWorker is a thin Soul
# distribution layer over Paseo; Paseo owns the employee runtime and workspace UI.

###############################################################################
# AIWorker CLI / local development
###############################################################################

# Source checkout state root for local AIWorker planning artifacts.
AIWORKER_HOME=$HOME/.aiworker-dev

# Static admin identity used by local scripts/tests when no enterprise auth is wired.
AIWORKER_ADMIN_EMAIL=admin@example.com

###############################################################################
# Provisioning targets
###############################################################################

# Default aissh target reference used by local smoke commands.
AIWORKER_DEFAULT_AISSH_TARGET=aissh:devbox

# Default Paseo home and daemon endpoint recorded in generated provision plans.
AIWORKER_DEFAULT_PASEO_HOME=$HOME/.paseo
AIWORKER_DEFAULT_PASEO_DAEMON_ENDPOINT=127.0.0.1:6767

###############################################################################
# Provider profiles
###############################################################################

# Provider secrets are stored outside AIWorker and referenced by name only.
# Do not put provider API keys in this file.
AIWORKER_DEFAULT_PROVIDER=codex
AIWORKER_DEFAULT_PROVIDER_PROFILE=codex-default
AIWORKER_DEFAULT_PROVIDER_SECRET_REF=secret://local/codex-default

###############################################################################
# Optional enterprise auth placeholders
###############################################################################

# These are placeholders for a future AIWorker UI/API. Leave empty in the current
# CLI-first thin layer unless an integration explicitly consumes them.
AIWORKER_SESSION_SECRET=
AIWORKER_ALLOWED_EMAIL_DOMAINS=
LOGTO_CLIENT_ID=
LOGTO_CLIENT_SECRET=
LOGTO_ENDPOINT=
LOGTO_ISSUER=
