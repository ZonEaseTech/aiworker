# AIWorker root environment example.
# Copy values into .env for local development. AIWorker is a thin Soul
# distribution layer over Paseo; Paseo owns the employee runtime and workspace UI.

###############################################################################
# AIWorker CLI / local development
###############################################################################

# Central machine home for AIWorker state. Defaults to $HOME/.aiworker when unset;
# the control plane defaults to $AIWORKER_HOME/control-plane (so `aiworker web` runs live).
# Local source checkouts use a separate dev home to avoid touching the real ~/.aiworker.
AIWORKER_HOME=$HOME/.aiworker-dev

# Static admin identity used by local scripts/tests when no enterprise auth is wired.
AIWORKER_ADMIN_EMAIL=admin@example.com

###############################################################################
# Provisioning targets
###############################################################################

# Default aissh target reference used by local smoke commands.
AIWORKER_DEFAULT_AISSH_TARGET=aissh:devbox

# Real aissh execution is env-only. Keep token values in ignored .env or a secret manager; never copy them into Souls, receipts, logs, or docs.
AISSH_TOKEN=
AISSH_SERVER=
AISSH_BIN=

# Default Paseo home and daemon endpoint recorded in generated provision plans.
# New plans derive owner-scoped values from the assigned user:
#   PASEO_HOME=$HOME/.aiworker/<userSlug>/.paseo
#   PASEO_LISTEN=127.0.0.1:<stable-user-port>
AIWORKER_DEFAULT_PASEO_HOME=
AIWORKER_DEFAULT_PASEO_DAEMON_ENDPOINT=

###############################################################################
# Provider profiles
###############################################################################

# Provider secrets are stored outside AIWorker and referenced by name only.
# Do not put provider API keys in this file.
AIWORKER_DEFAULT_PROVIDER=codex
AIWORKER_DEFAULT_PROVIDER_PROFILE=codex-default
AIWORKER_DEFAULT_PROVIDER_SECRET_REF=secret://local/codex-default

###############################################################################
# AIWorker Web admin console
###############################################################################

# Local admin console binds loopback by default. Use a non-loopback host only
# behind an authenticated admin boundary. Non-loopback binding without Logto
# causes Web to fail closed.
AIWORKER_WEB_HOST=127.0.0.1
AIWORKER_WEB_ALLOW_REMOTE=
AIWORKER_WEB_REQUIRE_AUTH=

# Optional bearer/admin token for state-changing Web API calls.
AIWORKER_WEB_ADMIN_TOKEN=
# Explicit control-plane directory override. Leave empty to derive it from
# AIWORKER_HOME (default $AIWORKER_HOME/control-plane). A non-empty value wins.
AIWORKER_CONTROL_PLANE_DIR=

###############################################################################
# AIWorker Web Logto admin login
###############################################################################

# Run `bun run setup:logto` to create/update a Traditional Logto app and write
# these values into ignored .env. LOGTO_CLIENT_* are canonical for AIWorker Web;
# sibling aiworker-next LOGTO_APP_* values are accepted by the setup/runtime as aliases.
AIWORKER_SESSION_SECRET=
AIWORKER_ALLOWED_EMAIL_DOMAINS=
LOGTO_BASE_URL=https://20831--main--ben--ben.coder.tbc.5ok.co
LOGTO_ALLOWED_EMAIL_DOMAINS=
LOGTO_CLIENT_ID=
LOGTO_CLIENT_SECRET=
LOGTO_COOKIE_SECRET=
LOGTO_ENDPOINT=
# Derived by OIDC discovery; kept only for older local env compatibility.
LOGTO_ISSUER=

###############################################################################
# Explicit real-environment Web E2E gate
###############################################################################

# Requires a dedicated/disposable target. This gate approves, applies, and pairs
# through Web using real aissh/Paseo state. It never reads .aissh.yaml secrets;
# provide AISSH_TOKEN through the process environment.
AIWORKER_WEB_LIVE_E2E=
AIWORKER_WEB_LIVE_E2E_DEDICATED_TARGET=
AIWORKER_WEB_E2E_ASSIGNMENT_ID=
AIWORKER_WEB_E2E_BASE_URL=
