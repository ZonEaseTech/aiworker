{
  "name": "aiworker",
  "type": "module",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "lint": "eslint .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "build": "bun run --filter '*' build",
    "check": "bun run typecheck && bun run lint",
    "db:generate": "bun run --filter '@zonease/aiworker-storage-sqlite' db:generate",
    "db:generate:fleet": "bun run --filter '@zonease/aiworker-storage-sqlite' db:generate:fleet",
    "db:generate:worker": "bun run --filter '@zonease/aiworker-storage-sqlite' db:generate:worker"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.13.2",
    "@eslint-react/eslint-plugin": "^1.38.4",
    "eslint": "^9.27.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "jiti": "^2.6.1",
    "typescript": "^5.8.3"
  }
}
