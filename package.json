{
  "name": "aiworker",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "souls/*"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0 <21 || >=22.12.0"
  },
  "scripts": {
    "dev": "bun run dev:aiworker",
    "dev:env:check": "bun scripts/check-env-structure.ts",
    "dev:env:sync": "bun scripts/check-env-structure.ts --write",
    "dev:aiworker": "bun apps/aiworker-cli/src/aiworker.ts --help",
    "setup:logto": "bun scripts/setup-logto.mjs",
    "lint": "eslint . && bun scripts/check-soul-app-boundaries.ts && bun run docs:check",
    "typecheck": "bun run --filter '*' typecheck && bun run typecheck:scripts",
    "test": "bun run --filter '*' test && bun run test:contracts",
    "test:aiworker": "bun run --filter '@zonease/aiworker-cli' test && bun run --filter '@zonease/aiworker-control' test",
    "build": "bun run build:aiworker && bun run build:official-souls",
    "build:aiworker": "bun run --filter '@zonease/aiworker-cli' build",
    "build:official-souls": "bun scripts/official-soul-dist.ts",
    "smoke:dist-release": "bun run --filter '@zonease/aiworker-cli' smoke:dist-release",
    "test:contracts": "bun test tests/architecture scripts/*.test.ts",
    "test:protocol": "bun run --filter '@zonease/aiworker-soul-descriptor' test",
    "ui:check": "bun run test:aiworker-web",
    "e2e:aiworker-web:live": "bun scripts/aiworker-web-live-e2e.ts",
    "docs:check": "bun scripts/check-doc-contract.ts",
    "check": "bun run typecheck && bun run lint",
    "release:check": "bun run docs:check && bun run typecheck && bun run lint && bun run build && bun run smoke:dist-release && bun run test",
    "serena:ps": "bash scripts/serena-processes.sh status",
    "serena:clean": "bash scripts/serena-processes.sh clean",
    "crg:status": "uvx code-review-graph status --repo .",
    "crg:update": "uvx code-review-graph update --repo . --base HEAD",
    "crg:review": "uvx code-review-graph detect-changes --repo . --base HEAD --brief",
    "crg:build": "uvx code-review-graph build --repo .",
    "crg:watch": "uvx code-review-graph watch --repo .",
    "prepare": "husky",
    "commitlint": "commitlint",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json --noEmit",
    "dev:aiworker-web": "bun run --filter '@zonease/aiworker-web' dev",
    "test:aiworker-web": "bun run --filter '@zonease/aiworker-web' test",
    "build:aiworker-web": "bun run --filter '@zonease/aiworker-web' build:release"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.13.2",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@types/bun": "^1.2.13",
    "eslint": "^9.27.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "typescript": "^5.8.3"
  }
}
