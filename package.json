{
  "name": "aiworker",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "lint": "eslint .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "build": "bun run --filter '@zonease/aiworker-api' build && bun run --filter '@zonease/aiworker-web' build && bun run --filter '@zonease/aiworker-cli' build:bundle",
    "check": "bun run typecheck && bun run lint",
    "crg:status": "uvx code-review-graph status --repo .",
    "crg:update": "uvx code-review-graph update --repo . --base HEAD",
    "crg:review": "uvx code-review-graph detect-changes --repo . --base HEAD --brief",
    "crg:build": "uvx code-review-graph build --repo .",
    "crg:watch": "uvx code-review-graph watch --repo .",
    "db:generate": "bun run --filter '@zonease/aiworker-storage-sqlite' db:generate",
    "db:generate:fleet": "bun run --filter '@zonease/aiworker-storage-sqlite' db:generate:fleet",
    "db:generate:worker": "bun run --filter '@zonease/aiworker-storage-sqlite' db:generate:worker"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.13.2",
    "@eslint-react/eslint-plugin": "^1.38.4",
    "eslint": "^9.27.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "jiti": "^2.6.1",
    "typescript": "^5.8.3"
  }
}
